# Copy this file to  .env  and fill in your own values. .env is ignored by git.

# The API key shown in the RIT Client (click "API" at the bottom right).
RIT_API_KEY=Rotman

# Only needed if the RIT Client's API port is not 9999.
# RIT_API=http://localhost:9999/v1

# ETF case only: if its RIT Client uses a different port (or key) than the volatility case.
# ETF_RIT_API=http://localhost:9998/v1
# ETF_RIT_API_KEY=

# ETF tuning (optional). Defaults are calibrated on the Nov 16 real heats (replay_etf_tenders.py).
# TENDER_HEDGE_COST=0.15    # CAD/share a BULL+BEAR hedge really costs; lower = accept more tenders
# TENDER_MIN_EDGE=0.05      # CAD/share profit required on top of that
# FAST_SLIP=0.03            # after a tender, hedge everything within this of the best price each tick

# Patient tender mode: take tenders that beat BOTH the basket and RITC by PATIENT_MIN_EDGE and unwind them at the best
# prices in RITC and BULL+BEAR at once instead of walking the books (stop-loss hedges the rest). Default is TENDER_MODE=hedge.
# TENDER_MODE=patient
# PATIENT_MIN_EDGE=0.05     # CAD/share the tender must beat the worse of basket mid and RITC mid by
# PATIENT_PER_TICK=10000    # RITC sold back per tick, best price only
# PATIENT_BASKET=10000      # plus this many hedged with BULL+BEAR per tick, best prices only
# PATIENT_STOP=0.20         # USD/share against us -> hedge the rest with BULL+BEAR at market
# PATIENT_TICKS=30          # time limit for the unwind
